        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# 1. Definir los datos del estudio\n",
        "grupos = ['Control', 'Tratamiento A', 'Tratamiento B']\n",
        "medias = [90, 67.8, 82.4]\n",
        "errores = [8.3, 6.1, 5.2]   # Desviación estándar\n",
        "\n",
        "# 2. Crear la figura y los ejes\n",
        "fig, ax = plt.subplots(figsize=(7, 5))\n",
        "\n",
        "# 3. Dibujar las barras\n",
        "x = np.arange(len(grupos))  # posiciones en eje X: [0, 1, 2]\n",
        "bars = ax.bar(x, medias,\n",
        "              yerr=errores,\n",
        "              capsize=5,\n",
        "              color=['#4878D0', '#EE854A', '#6ACC65'],\n",
        "              edgecolor='black',\n",
        "              linewidth=0.8)\n",
        "\n",
        "# 4. Etiquetas y título (OBLIGATORIOS para journals)\n",
        "ax.set_ylabel('Respuesta celular (%)', fontsize=12)\n",
        "ax.set_xlabel('Grupo experimental', fontsize=12)\n",
        "ax.set_title('Figura 1. Respuesta celular por grupo', fontsize=13)\n",
        "ax.set_xticks(x)\n",
        "ax.set_xticklabels(grupos)\n",
        "ax.set_ylim(0, 100)\n",
        "\n",
        "# 5. Guardar en alta resolución para publicar\n",
        "plt.tight_layout()\n",
        "plt.savefig('figura1.pdf', dpi=300, bbox_inches='tight')\n",
        "plt.show()"
      ]
